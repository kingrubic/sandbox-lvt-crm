{
  "name": "lvt-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:production": "npm run typecheck && VITE_CONVEX_URL=https://confident-guanaco-953.convex.cloud vite build",
    "start": "node scripts/serve-production.mjs",
    "preview": "vite preview",
    "check": "node scripts/check-files.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "./node_modules/.bin/tsc --project tsconfig.app.json && ./node_modules/.bin/tsc --project convex/tsconfig.json --noEmit",
    "typecheck:convex-codegen": "./scripts/lvt-convex-cloud-env.sh dev ./node_modules/.bin/convex codegen --typecheck enable",
    "convex:dev": "./scripts/lvt-convex-cloud-env.sh dev ./node_modules/.bin/convex dev",
    "convex:deploy": "./scripts/lvt-convex-cloud-env.sh prod ./node_modules/.bin/convex deploy"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.94",
    "@fontsource-variable/montserrat": "^5.3.0",
    "convex": "^1.42.3",
    "docx-preview": "^0.4.0",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
